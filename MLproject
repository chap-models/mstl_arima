name: chap_mstl_arima

meta_data:
  author: Knut Rand
  author_note: >
    Two-step pipeline. STL (LOESS-smoothed seasonal-trend decomposition)
    strips the seasonal component, an AutoARIMA model forecasts the
    trend+remainder, and the last observed seasonal cycle is
    extrapolated forward. Models are fit on log1p(disease_cases) and
    probabilistic samples are drawn from the parametric predictive
    Normal.
  author_assessed_status: yellow
  contact_email: knutdrand@gmail.com
  description: >
    MSTL + AutoARIMA baseline for chap. Designed for small, noisy,
    highly-seasonal surveillance data. Self-forecasts seasonality and
    does not depend on future covariates.
  display_name: MSTL + AutoARIMA
  organization: HISP Centre, University of Oslo
  organization_logo_url: https://landportal.org/sites/default/files/2024-03/university_of_oslo_logo.png
  citation_info: >
    Climate Health Analytics Platform. 2026. "MSTL + AutoARIMA Model".
    HISP Centre, University of Oslo.

allow_free_additional_continuous_covariates: false
required_covariates: []
supported_period_type: any
target: disease_cases

user_options:
  n_samples:
    default: 100
    title: Number of probabilistic samples
    type: integer
  log_transform:
    default: true
    title: Fit on log1p(disease_cases)
    type: boolean
  season_length_monthly:
    default: 12
    title: Season length for monthly data
    type: integer
  season_length_weekly:
    default: 52
    title: Season length for weekly data
    type: integer
  random_seed:
    default: 42
    title: Random seed for sampling
    type: integer
  arima_approximation:
    default: false
    title: AutoARIMA approximation (faster, drops MA — less calibrated)
    type: boolean
  arima_stepwise:
    default: true
    title: AutoARIMA stepwise search
    type: boolean

uv_env: pyproject.toml

entry_points:
  train:
    parameters:
      train_data: str
      model: str
      model_config: str
    command: "python main.py train {train_data} {model} {model_config}"
  predict:
    parameters:
      model: str
      historic_data: str
      future_data: str
      out_file: str
      model_config: str
    command: "python main.py predict {model} {historic_data} {future_data} {out_file} {model_config}"
